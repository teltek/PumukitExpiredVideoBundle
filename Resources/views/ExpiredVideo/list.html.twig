{% extends '@PumukitNewAdmin/layout.html.twig' %}

{% block body %}
    <h3 class="cab_body_div">
        <ul class="breadcrumb pmk-margin-bottom-5">
            <li class="active breadcrumb-item">{% trans %}Multimedia objects coming to expire{% endtrans %}</li>
        </ul>
    </h3>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message|trans }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{% trans %}Close{% endtrans %}"></button>
        </div>
    {% endfor %}

    {% set token = csrf_token(constant('Pumukit\\ExpiredVideoBundle\\Controller\\ExpiredVideoAdminController::CSRF_TOKEN')) %}
    {% set page = multimediaObjects.currentPage %}

    <div class="table-responsive pmk-well">
        <table class="table table-striped table-hover align-middle">
            <thead>
            <tr>
                <th>{% trans %}Id{% endtrans %}</th>
                <th>{% trans %}Img{% endtrans %}</th>
                <th>{% trans %}Title{% endtrans %}</th>
                <th>{% trans %}Publication{% endtrans %}</th>
                <th>{% trans %}Expiration{% endtrans %}</th>
                <th>{% trans %}Owners{% endtrans %}</th>
                <th>{% trans %}Actions{% endtrans %}</th>
            </tr>
            </thead>
            <tbody>
            {% for multimediaObject in multimediaObjects %}
                {% set expired = multimediaObject.properties.expiration_date <= now %}
                <tr class="{{ expired ? 'table-danger' : '' }}">
                    <td>
                        <a href="{{ path('pumukitnewadmin_mms_shortener', {'id': multimediaObject.id}) }}">{{ multimediaObject.id }}</a>
                    </td>
                    <td>
                        <img class="img-fluid" width="120" src="{{ multimediaObject|first_url_pic(true, false) }}" alt="{% trans %}Multimedia object picture{% endtrans %}">
                    </td>
                    <td>{{ multimediaObject.title }} - {{ multimediaObject.series.title }}</td>
                    <td>{{ multimediaObject.getPublicDate()|date('Y/m/d') }}</td>
                    <td>{{ multimediaObject.properties.expiration_date|date('Y/m/d') }}</td>
                    <td>
                        <ul class="list-unstyled mb-0">
                            {% for person in multimediaObject.getPeopleByRole(ownerRol, true) %}
                                <li><a href="mailto:{{ person.email }}">{{ person.name }}</a></li>
                            {% endfor %}
                        </ul>
                    </td>
                    <td>
                        {% if expired %}
                            <div class="d-flex flex-column gap-1">
                                <form method="post" action="{{ path('pumukit_expired_video_delete', {'id': multimediaObject.id}) }}"
                                      data-controller="expired-video--confirm"
                                      data-action="submit->expired-video--confirm#confirm"
                                      data-expired-video--confirm-message-value="{{ 'Are you sure to delete this video?'|trans }} {{ multimediaObject.title }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input type="hidden" name="page" value="{{ page }}">
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger">{% trans %}Delete{% endtrans %}</button>
                                </form>
                                <form method="post" action="{{ path('pumukit_expired_video_update', {'id': multimediaObject.id}) }}"
                                      data-controller="expired-video--confirm"
                                      data-action="submit->expired-video--confirm#confirm"
                                      data-expired-video--confirm-message-value="{{ 'Are you sure to update this video?'|trans }} {{ multimediaObject.title }}">
                                    <input type="hidden" name="_token" value="{{ token }}">
                                    <input type="hidden" name="page" value="{{ page }}">
                                    <button type="submit" class="btn btn-link btn-sm p-0">{% trans %}Renew with the same owners{% endtrans %}</button>
                                </form>
                            </div>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="text-center text-muted">{% trans %}There are no videos about to expire.{% endtrans %}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if multimediaObjects.haveToPaginate %}
            {% include '@PumukitNewAdmin/Misc/pager.html.twig' with {
                'objects': multimediaObjects,
                'pagerStyles': {'css_container_class': 'pagination pagination-sm', 'next_message': '&raquo;', 'prev_message': '&laquo;', 'routeName': 'pumukit_expired_video_list'}
            } %}
        {% endif %}
    </div>
{% endblock %}
