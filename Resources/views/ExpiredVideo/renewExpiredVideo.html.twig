{% extends '@PumukitWebTV/layout.html.twig' %}

{% block body %}
    <div class="row justify-content-center mt-4">
        <div class="col-md-6 text-center">
            {% if message == 0 %}
                <h4>{% trans %}The multimedia object has been successfully renewed.{% endtrans %}</h4>
            {% elseif message == 1 or message == 4 %}
                <h4>{% trans %}You aren't the owner of this multimedia object.{% endtrans %}</h4>
            {% elseif message == 2 %}
                <h4>{% trans %}This multimedia object has already been renewed.{% endtrans %}</h4>
            {% elseif message == 3 %}
                <h4>{% trans %}Multimedia object doesn't exists.{% endtrans %}</h4>
            {% endif %}
        </div>
    </div>
    <div class="row justify-content-center mt-4">
        <div class="col-md-4">
            <a href="{{ path('homepage') }}" class="btn btn-secondary w-100">{% trans %}Return{% endtrans %}</a>
        </div>
    </div>
{% endblock %}
