<div class="modal-header">
    <h3 class="modal-title" id="myModalLabel">{% trans %}Multimedia objects list{% endtrans %}</h3>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{% trans %}Close{% endtrans %}"></button>
</div>

<form action="{{ path('pumukit_expired_series_renew_all', {'id': series.id}) }}" method="post"
      data-controller="admin--modal-form"
      data-action="submit->admin--modal-form#submit"
      data-admin--modal-form-success-message-value="{{ 'Multimedia objects updated'|trans }}"
      data-admin--modal-form-fail-message-value="{{ 'Multimedia objects cant updated'|trans }}">
    <div class="modal-body">
        <table class="table table-striped table-hover">
            <thead>
            <tr>
                <th scope="col">{% trans %}Title{% endtrans %}</th>
                <th scope="col">{% trans %}Expiration Date{% endtrans %}</th>
            </tr>
            </thead>
            <tbody>
            {% for multimediaObject in multimediaObjects %}
                <tr>
                    <td>{{ multimediaObject.getTitle()|default('No title'|trans) }}</td>
                    <td>{{ multimediaObject.getProperty('expiration_date') ? multimediaObject.getProperty('expiration_date')|date('Y/m/d') : '-' }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        <div class="mb-3">
            <label class="form-label" for="expiration_date_from">{% trans %}Update expiration date{% endtrans %}</label>
            <input type="date" class="form-control w-auto" name="date" id="expiration_date_from">
            <div class="form-text">{% trans %}Leave it empty to renew with the default period.{% endtrans %}</div>
        </div>
    </div>

    <div class="modal-footer">
        <button type="submit" class="btn btn-pumukit">{% trans %}Renew{% endtrans %}</button>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{% trans %}Close{% endtrans %}</button>
    </div>
</form>
